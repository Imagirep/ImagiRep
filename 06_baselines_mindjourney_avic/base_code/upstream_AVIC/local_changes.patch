+class GeminiChatAPI:
+    """Small adapter exposing the ChatAPI interface through google-genai."""
+
+    def __init__(self, model: str, api_price: float = 0.0):
+        from google import genai
+
+        api_key = os.environ.get("GEMINI_API_KEY", "")
+        if not api_key:
+            raise RuntimeError("Gemini is not configured. Set GEMINI_API_KEY.")
+        self.client = genai.Client(api_key=api_key)
+        self.model = os.environ.get("GEMINI_MODEL", model)
+        self.price = api_price
+        self.messages: List[Dict[str, str]] = []
+        self.history: List[Dict[str, str]] = []
+        self.total_usage_tokens = 0
+        self.usage_history = []
+        self.cost = 0.0
+
+    @staticmethod
+    def _parts(content):
+        from google.genai import types
+
+        parts = []
+        for item in content:
+            if item.get("type") == "text":
+                parts.append(types.Part.from_text(text=item.get("text", "")))
+                continue
+            if item.get("type") != "image_url":
+                continue
+            url = item.get("image_url", {}).get("url", "")
+            if not url.startswith("data:") or "," not in url:
+                raise ValueError("Gemini adapter only accepts base64 data URLs for images.")
+            header, payload = url.split(",", 1)
+            mime_type = header[5:].split(";", 1)[0] or "image/jpeg"
+            image_bytes = base64.b64decode(payload)
+            # Validate early so corrupt local images fail with a useful error.
+            Image.open(BytesIO(image_bytes)).verify()
+            parts.append(types.Part.from_bytes(data=image_bytes, mime_type=mime_type))
+        return parts
+
+    def get_system_response_with_content(self, sys_prompt, content) -> str:
+        from google.genai import types
+
+        thinking_level_name = os.environ.get("GEMINI_THINKING_LEVEL", "").strip().upper()
+        if thinking_level_name:
+            try:
+                thinking_config = types.ThinkingConfig(
+                    thinking_level=getattr(types.ThinkingLevel, thinking_level_name)
+                )
+            except AttributeError as exc:
+                raise ValueError(
+                    f"Unsupported GEMINI_THINKING_LEVEL={thinking_level_name!r}. "
+                    "Expected MINIMAL, LOW, MEDIUM, or HIGH."
+                ) from exc
+        else:
+            thinking_config = types.ThinkingConfig(
+                thinking_budget=int(os.environ.get("GEMINI_THINKING_BUDGET", "0"))
+            )
+
+        config_kwargs = dict(
+            system_instruction=sys_prompt,
+            temperature=0,
+            max_output_tokens=int(os.environ.get("GEMINI_MAX_OUTPUT_TOKENS", "1024")),
+            thinking_config=thinking_config,
+        )
+        response_enum = [
+            value.strip().upper()
+            for value in os.environ.get("GEMINI_RESPONSE_ENUM", "").split(",")
+            if value.strip()
+        ]
+        if response_enum:
+            config_kwargs.update(
+                response_mime_type="text/x.enum",
+                response_schema={"type": "STRING", "enum": response_enum},
+            )
+        config = types.GenerateContentConfig(**config_kwargs)
+        parts = self._parts(content)
+        max_attempts = int(os.environ.get("GEMINI_MAX_RETRIES", "8"))
+        last_exc = None
+        for attempt in range(1, max_attempts + 1):
+            try:
+                response = self.client.models.generate_content(
+                    model=self.model,
+                    contents=[types.Content(role="user", parts=parts)],
+                    config=config,
+                )
+                break
+            except Exception as exc:
+                last_exc = exc
+                status = getattr(exc, "status_code", None)
+                retryable = status in {429, 500, 502, 503, 504} or any(
+                    marker in str(exc)
+                    for marker in (
+                        "UNAVAILABLE",
+                        "Deadline expired",
+                        "RESOURCE_EXHAUSTED",
+                        "INTERNAL",
+                    )
+                )
+                if not retryable or attempt >= max_attempts:
+                    raise
+                wait_s = min(120.0, 2 ** attempt + random.uniform(0, 1.5))
+                logger.warning(
+                    "Gemini generate_content failed on attempt %s/%s (%s); retrying in %.1fs",
+                    attempt,
+                    max_attempts,
+                    exc,
+                    wait_s,
+                )
+                time.sleep(wait_s)
+        else:
+            raise last_exc
+        usage = getattr(response, "usage_metadata", None)
+        usage_dict = usage.model_dump() if usage is not None else {}
+        used = int(usage_dict.get("total_token_count") or 0)
+        self.total_usage_tokens += used
+        self.usage_history.append({"model": self.model, "usage_tokens": used})
+        return response.text or ""
+
+    def clear(self):
+        self.messages = []
+        self.history = []
+
+
