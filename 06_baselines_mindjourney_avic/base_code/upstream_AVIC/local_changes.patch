+def find_nearest_source_inds(
+    source_c2ws,
+    target_c2ws,
+    nearest_num=1,
+    mode="translation",
+):
+    dists = get_camera_dist(source_c2ws, target_c2ws, mode=mode).cpu().numpy()
+    sorted_inds = np.argsort(dists, axis=0).T
+    return sorted_inds[:, :nearest_num]
